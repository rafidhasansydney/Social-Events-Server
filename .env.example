# Copy this file as .env and fill in the real values.
# .env is gitignored and must NEVER be committed to GitHub.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (Atlas থেকে পাওয়া string এখানে বসাও)
MONGODB_URI=your_mongodb_atlas_connection_string
MONGODB_DB_NAME=bandhan

# BetterAuth base URL (server's own address)
BETTER_AUTH_URL=http://localhost:5000

# Random secret used to sign auth tokens (node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=paste_a_generated_random_secret_here

# Google OAuth credentials (Google Cloud Console থেকে পাওয়া)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL, used for CORS and post-login redirects
CLIENT_URL=http://localhost:3000
